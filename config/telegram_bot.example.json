{
  "telegram": {
    "enabled": false,
    "bot_token_env": "TELEGRAM_BOT_TOKEN",
    "bot_token": "",
    "allowed_chat_ids": [],
    "poll_timeout_seconds": 25,
    "reply_max_chars": 3000,
    "response_mode": "auto",
    "send_ack_before_long_reply": true,
    "ack_max_chars": 500,
    "answer_cache_ttl_seconds": 900,
    "total_answer_timeout_seconds": 20
  },
  "llm": {
    "enabled": false,
    "provider": "deepseek",
    "api_key_env": "DEEPSEEK_API_KEY",
    "api_key": "",
    "base_url": "https://api.deepseek.com",
    "model": "deepseek-chat",
    "max_tokens": 900,
    "temperature": 0.2,
    "timeout_seconds": 14
  }
}
